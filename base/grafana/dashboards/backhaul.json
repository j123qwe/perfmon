          "expr": "sum_over_time(probe_icmp_duration_seconds{phase=\"rtt\",module=~\"icmp.*\",probe_node=~\"$node\",name=~\"$target\"}[$__range]) / ignoring(phase) (sum_over_time(probe_success{module=~\"icmp.*\",probe_node=~\"$node\",name=~\"$target\"}[$__range]) > 0)",
